<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.oa.mapper.LeaveRequestMapper">
    
    <resultMap type="com.ruoyi.oa.domain.LeaveRequest" id="LeaveRequestResult">
        <result property="id"    column="id"    />
        <result property="employeeId"    column="employee_id"    />
        <result property="leaveType"    column="leave_type"    />
        <result property="startDate"    column="start_date"    />
        <result property="endDate"    column="end_date"    />
        <result property="reason"    column="reason"    />
        <result property="status"    column="status"    />
        <result property="processDefinitionId"    column="process_definition_id"    />
        <result property="processStatus"    column="process_status"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="updateBy"    column="update_by"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectLeaveRequestVo">
        select id, employee_id, leave_type, start_date, end_date, reason, status, process_definition_id, process_status, create_time, update_time, create_by, update_by, remark from t_leave_request
    </sql>

    <select id="selectLeaveRequestList" parameterType="com.ruoyi.oa.domain.LeaveRequest" resultMap="LeaveRequestResult">
        <include refid="selectLeaveRequestVo"/>
        <where>  
            <if test="employeeId != null "> and employee_id = #{employeeId}</if>
            <if test="leaveType != null  and leaveType != ''"> and leave_type = #{leaveType}</if>
            <if test="startDate != null "> and start_date = #{startDate}</if>
            <if test="endDate != null "> and end_date = #{endDate}</if>
            <if test="reason != null  and reason != ''"> and reason = #{reason}</if>
            <if test="processDefinitionId != null  and processDefinitionId != ''"> and process_definition_id = #{processDefinitionId}</if>
            <if test="processStatus != null  and processStatus != ''"> and process_status = #{processStatus}</if>
        </where>
    </select>
    
    <select id="selectLeaveRequestById" parameterType="Long" resultMap="LeaveRequestResult">
        <include refid="selectLeaveRequestVo"/>
        where id = #{id}
    </select>

    <insert id="insertLeaveRequest" parameterType="LeaveRequest" useGeneratedKeys="true" keyProperty="id">
        insert into t_leave_request
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="employeeId != null">employee_id,</if>
            <if test="leaveType != null and leaveType != ''">leave_type,</if>
            <if test="startDate != null">start_date,</if>
            <if test="endDate != null">end_date,</if>
            <if test="reason != null and reason != ''">reason,</if>
            <if test="status != null">status,</if>
            <if test="processDefinitionId != null">process_definition_id,</if>
            <if test="processStatus != null">process_status,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="createBy != null">create_by,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="employeeId != null">#{employeeId},</if>
            <if test="leaveType != null and leaveType != ''">#{leaveType},</if>
            <if test="startDate != null">#{startDate},</if>
            <if test="endDate != null">#{endDate},</if>
            <if test="reason != null and reason != ''">#{reason},</if>
            <if test="status != null">#{status},</if>
            <if test="processDefinitionId != null">#{processDefinitionId},</if>
            <if test="processStatus != null">#{processStatus},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateLeaveRequest" parameterType="com.ruoyi.oa.domain.LeaveRequest">
        update t_leave_request
        <trim prefix="SET" suffixOverrides=",">
            <if test="employeeId != null">employee_id = #{employeeId},</if>
            <if test="leaveType != null and leaveType != ''">leave_type = #{leaveType},</if>
            <if test="startDate != null">start_date = #{startDate},</if>
            <if test="endDate != null">end_date = #{endDate},</if>
            <if test="reason != null and reason != ''">reason = #{reason},</if>
            <if test="status != null">status = #{status},</if>
            <if test="processDefinitionId != null">process_definition_id = #{processDefinitionId},</if>
            <if test="processStatus != null">process_status = #{processStatus},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteLeaveRequestById" parameterType="Long">
        delete from t_leave_request where id = #{id}
    </delete>

    <delete id="deleteLeaveRequestByIds" parameterType="String">
        delete from t_leave_request where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>