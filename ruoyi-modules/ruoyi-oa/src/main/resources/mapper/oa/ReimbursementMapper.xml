<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.oa.mapper.ReimbursementMapper">
    
    <resultMap type="com.ruoyi.oa.domain.Reimbursement" id="ReimbursementResult">
        <result property="id"    column="id"    />
        <result property="employeeId"    column="employee_id"    />
        <result property="reimbursementAmount"    column="reimbursement_amount"    />
        <result property="reimbursementType"    column="reimbursement_type"    />
        <result property="description"    column="description"    />
        <result property="invoiceCount"    column="invoice_count"    />
        <result property="submissionDate"    column="submission_date"    />
        <result property="processDefinitionId"    column="process_definition_id"    />
        <result property="processState"    column="process_state"    />
        <result property="status"    column="status"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="updateBy"    column="update_by"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectReimbursementVo">
        select id, employee_id, reimbursement_amount, reimbursement_type, description, invoice_count, submission_date, process_definition_id, process_state, status, create_time, update_time, create_by, update_by, remark from t_reimbursement
    </sql>

    <select id="selectReimbursementList" parameterType="com.ruoyi.oa.domain.Reimbursement" resultMap="ReimbursementResult">
        <include refid="selectReimbursementVo"/>
        <where>  
            <if test="reimbursementAmount != null "> and reimbursement_amount = #{reimbursementAmount}</if>
            <if test="reimbursementType != null  and reimbursementType != ''"> and reimbursement_type = #{reimbursementType}</if>
            <if test="description != null  and description != ''"> and description = #{description}</if>
            <if test="invoiceCount != null "> and invoice_count = #{invoiceCount}</if>
            <if test="submissionDate != null "> and submission_date = #{submissionDate}</if>
            <if test="processDefinitionId != null  and processDefinitionId != ''"> and process_definition_id = #{processDefinitionId}</if>
            <if test="processState != null  and processState != ''"> and process_state = #{processState}</if>
        </where>
    </select>
    
    <select id="selectReimbursementById" parameterType="Long" resultMap="ReimbursementResult">
        <include refid="selectReimbursementVo"/>
        where id = #{id}
    </select>

    <insert id="insertReimbursement" parameterType="Reimbursement" useGeneratedKeys="true" keyProperty="id">
        insert into t_reimbursement
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="employeeId != null">employee_id,</if>
            <if test="reimbursementAmount != null">reimbursement_amount,</if>
            <if test="reimbursementType != null and reimbursementType != ''">reimbursement_type,</if>
            <if test="description != null">description,</if>
            <if test="invoiceCount != null">invoice_count,</if>
            <if test="submissionDate != null">submission_date,</if>
            <if test="processDefinitionId != null">process_definition_id,</if>
            <if test="processState != null">process_state,</if>
            <if test="status != null">status,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="createBy != null">create_by,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="employeeId != null">#{employeeId},</if>
            <if test="reimbursementAmount != null">#{reimbursementAmount},</if>
            <if test="reimbursementType != null and reimbursementType != ''">#{reimbursementType},</if>
            <if test="description != null">#{description},</if>
            <if test="invoiceCount != null">#{invoiceCount},</if>
            <if test="submissionDate != null">#{submissionDate},</if>
            <if test="processDefinitionId != null">#{processDefinitionId},</if>
            <if test="processState != null">#{processState},</if>
            <if test="status != null">#{status},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateReimbursement" parameterType="com.ruoyi.oa.domain.Reimbursement">
        update t_reimbursement
        <trim prefix="SET" suffixOverrides=",">
            <if test="employeeId != null">employee_id = #{employeeId},</if>
            <if test="reimbursementAmount != null">reimbursement_amount = #{reimbursementAmount},</if>
            <if test="reimbursementType != null and reimbursementType != ''">reimbursement_type = #{reimbursementType},</if>
            <if test="description != null">description = #{description},</if>
            <if test="invoiceCount != null">invoice_count = #{invoiceCount},</if>
            <if test="submissionDate != null">submission_date = #{submissionDate},</if>
            <if test="processDefinitionId != null">process_definition_id = #{processDefinitionId},</if>
            <if test="processState != null">process_state = #{processState},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteReimbursementById" parameterType="Long">
        delete from t_reimbursement where id = #{id}
    </delete>

    <delete id="deleteReimbursementByIds" parameterType="String">
        delete from t_reimbursement where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>