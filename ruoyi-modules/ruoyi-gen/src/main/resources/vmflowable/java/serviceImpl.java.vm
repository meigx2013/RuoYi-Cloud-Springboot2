    /**
    * 启动流程
    *
    */
    @Override
    public int startProcess(${ClassName} ${className})
    {
        try {
            Map<String, Object> resultMap = BeanUtil.beanToMap(${className});
            resultMap.put("processKey",process_key);
            resultMap.put("processState","running");
            R<String> processInstanceId= remoteFlowableService.startProcessByKey(resultMap, SecurityConstants.INNER);
            if(processInstanceId!=null&&processInstanceId.getData()!=null){
                ${className}.setProcessDefinitionId(processInstanceId.getData());
                ${className}.setProcessState("running");
                return ${className}Mapper.update${ClassName}(${className});
            }
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
        return 0;
    }

    /**
     * 停止流程
     *
     */
    @Override
    public int stopProcess(${ClassName} ${className})
    {
        try {
            R<String> processInstanceId= remoteFlowableService.stopProcess(${className}.getProcessDefinitionId(), SecurityConstants.INNER);
            if(processInstanceId!=null&&processInstanceId.getData()!=null){
                ${className}.setProcessDefinitionId(processInstanceId.getData());
                ${className}.setProcessState("canceled");
                return ${className}Mapper.update${ClassName}(${className});
            }
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
        return 0;
    }

    /**
     * 撤回流程
     *
     */
    @Override
    public String revokeProcess(${ClassName} ${className})
    {
        Map<String, Object> resultMap = new HashMap<>();
        resultMap.put("procInsId",${className}.getProcessDefinitionId());
        resultMap.put("taskId",${className}.getTaskId());
        R<String> revokeProcess=remoteFlowableService.revokeProcess(resultMap, SecurityConstants.INNER);
        if (revokeProcess.getCode()==500){
            return revokeProcess.getMsg();
        }
        return "撤回成功";
    }
}
