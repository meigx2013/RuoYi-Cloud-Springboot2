    /**
     * 查询${functionName}列表
     * 
     * @param ${className} ${functionName}
     * @return ${functionName}
     */
    @Override
    public List<${ClassName}> select${ClassName}List(${ClassName} ${className})
    {
        try {
            if (StringUtils.isNotNull(${className}.getParams())&&${className}.getParams().get("processTab")!=null&&!"all".equals(${className}.getParams().get("processTab"))){
                FlowTaskVo flowTaskVo=new FlowTaskVo();
                flowTaskVo.setType((String) ${className}.getParams().get("processTab"));
                flowTaskVo.setProcessKey(process_key);
                PageDomain pageDomain = TableSupport.buildPageRequest();
                Integer pageNum = pageDomain.getPageNum();
                Integer pageSize = pageDomain.getPageSize();
                flowTaskVo.setPageNum(pageNum);
                flowTaskVo.setPageSize(pageSize);
                Map<String, Object> resultMap = BeanUtil.beanToMap(${className});
                flowTaskVo.setQueryMap(resultMap);
                R<TableDataInfo> result= remoteFlowableService.commonProcessList(flowTaskVo, SecurityConstants.INNER);
                List<${ClassName}> ${className}List = new ArrayList<>();
                if (result != null && result.getData() != null) {
                    List<Object> list = (List<Object>) result.getData().getRows();
                    for (Object obj : list) {
                        ObjectMapper objectMapper = new ObjectMapper();
                        // 将对象转换为 JSON 字符串
                        String jsonString = null;
                        jsonString = objectMapper.writeValueAsString(obj);
                        // 将 JSON 字符串解析为 Map
                        Map<String, Object> jsonMap = objectMapper.readValue(jsonString, Map.class);
                        // 获取 processVariables
                        Map<String, Object> processVariables = (Map<String, Object>) jsonMap.get("processVariables");
                        // 创建 TestProcess 对象并设置值
                        ${ClassName} ${className}Item = new  ${ClassName}();
                        BeanUtil.fillBeanWithMap(processVariables, ${className}Item, false);
                        // 根据实际情况继续设置其他字段
                        ${className}Item.set${ProcessStatusField}((String) jsonMap.get("processStatus"));
                        ${className}Item.setProcessDefinitionId((String) jsonMap.get("procInsId"));
                        ${className}Item.setTaskId((String) jsonMap.get("taskId"));
                            ${className}List.add(${className}Item);
                    }
                    return ${className}List;
                }
            }
        } catch (JsonProcessingException e) {
            throw new RuntimeException(e);
        }
        return ${className}Mapper.select${ClassName}List(${className});
    }

