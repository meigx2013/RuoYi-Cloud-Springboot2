import request from '@/utils/request'

// 查询${functionName}列表
export function list${BusinessName}(query) {
  return request({
    url: '/${moduleName}/${businessName}/list',
    method: 'get',
    params: query
  })
}

// 查询${functionName}详细
export function get${BusinessName}(${pkColumn.javaField}) {
  return request({
    url: '/${moduleName}/${businessName}/' + ${pkColumn.javaField},
    method: 'get'
  })
}

// 新增${functionName}
export function add${BusinessName}(data) {
  return request({
    url: '/${moduleName}/${businessName}',
    method: 'post',
    data: data
  })
}

// 修改${functionName}
export function update${BusinessName}(data) {
  return request({
    url: '/${moduleName}/${businessName}',
    method: 'put',
    data: data
  })
}

// 删除${functionName}
export function del${BusinessName}(${pkColumn.javaField}) {
  return request({
    url: '/${moduleName}/${businessName}/' + ${pkColumn.javaField},
    method: 'delete'
  })
}


// 提交送审
export function startProcess(data) {
  return request({
    url: '/${moduleName}/${businessName}/' +'startProcess',
    method: 'post',
    data: data
  })
}
// 停止流程
export function stopProcess(data) {
  return request({
    url: '/${moduleName}/${businessName}/' +'stopProcess',
    method: 'post',
    data: data
  })
}

// 撤回流程
export function revokeProcess(data) {
  return request({
    url: '/${moduleName}/${businessName}/' +'revokeProcess',
    method: 'post',
    data: data
  })
}